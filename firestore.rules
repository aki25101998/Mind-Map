rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);
      
      match /mindmaps/{mapId} {
        allow read: if isOwner(uid) || (
          resource.data.shareId != null &&
          get(/databases/$(database)/documents/shares/$(resource.data.shareId)).data.enabled == true
        );
        allow write: if isOwner(uid) || (
          resource.data.shareId != null &&
          get(/databases/$(database)/documents/shares/$(resource.data.shareId)).data.enabled == true &&
          get(/databases/$(database)/documents/shares/$(resource.data.shareId)).data.permission == 'edit'
        );
      }
    }

    match /shares/{shareId} {
      allow get: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
